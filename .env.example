# ==============================================================================
# PhishGuard AI — Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# ==============================================================================

# Server Environment
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change-to-a-secure-random-secret-key-in-production

# Network Binding
HOST=127.0.0.1
PORT=5000

# File & Model Paths
MODEL_PATH=models/phishing_url_model.pkl
FEATURES_PATH=models/phishing_url_features.pkl
DATA_PATH=data/Phishing_Dataset.csv
TRUSTED_DOMAINS_FILE=data/supplement_legit.txt

# Batch Scan Limits
MAX_BATCH_URLS=25

# Optional Threat Intelligence API Keys (Leave blank if unused)
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_KEY=
